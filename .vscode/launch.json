{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BIM (localhost, Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Web only, not the other targets: a browser enforces CORS on image
      // fetches (CanvasKit reads pixel bytes, not a passive <img> load),
      // and php artisan serve can't send CORS headers for static files —
      // Apache (already running via XAMPP) can, via public/.htaccess.
      "args": ["--dart-define=API_BASE_URL=http://localhost/testing/public/api/v2"]
    },
    {
      "name": "BIM (localhost, Windows desktop)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://localhost:8000/api/v2"]
    },
    {
      "name": "BIM (Android emulator, host alias)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v2"]
    },
    {
      "name": "BIM (real device, LAN IP)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://192.168.17.21:8000/api/v2"]
    },
    {
      "name": "BIM (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://localhost:8000/api/v2"]
    }
  ]
}
