{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BIM (localhost, Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Web only, not the other targets: a browser enforces CORS on image
      // fetches (CanvasKit reads pixel bytes, not a passive <img> load),
      // and php artisan serve can't send CORS headers for static files —
      // Apache (already running via XAMPP) can, via public/.htaccess.
      "args": ["--dart-define=API_BASE_URL=http://localhost/testing/public/api/v2"]
    },
    {
      "name": "BIM (localhost, Windows desktop)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://localhost:8000/api/v2"]
    },
    {
      "name": "BIM (Android emulator, host alias)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v2"]
    },
    {
      "name": "BIM (real phone, USB cable)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Run `adb reverse tcp:80 tcp:80` once after plugging the phone in: the phone's "localhost" then reaches XAMPP's Apache on this PC.
      "args": ["--dart-define=API_BASE_URL=http://localhost/testing/public/api/v2"]
    },
    {
      "name": "BIM (real phone, same Wi-Fi)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Put this PC's current IPv4 (ipconfig) here; it changes when the router hands out a new one.
      "args": ["--dart-define=API_BASE_URL=http://10.125.198.200/testing/public/api/v2"]
    },
    {
      "name": "BIM (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://localhost:8000/api/v2"]
    }
  ]
}
