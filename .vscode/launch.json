{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BIM (localhost, Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://localhost/testing/public/api/v2"]
    },
    {
      "name": "BIM (localhost, Windows desktop)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://localhost/testing/public/api/v2"]
    },
    {
      "name": "BIM (Android emulator, host alias)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2/testing/public/api/v2"]
    },
    {
      "name": "BIM (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://localhost/testing/public/api/v2"]
    }
  ]
}
